# Copy to `.env.local` for local development. All values are optional.

# Backend base URL (no trailing slash). Defaults to production.
VITE_API_BASE_URL=https://api.preachradio.com

# Google Maps JavaScript API key (Places library) for address autocomplete.
# Without it, location fields fall back to manual address + lat/lng entry.
VITE_GOOGLE_MAPS_API_KEY=
